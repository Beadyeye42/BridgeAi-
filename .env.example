# Supabase Postgres via the Vercel Marketplace integration.
# Use the transaction pooler for application traffic and the non-pooling URL for migrations.
POSTGRES_PRISMA_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
POSTGRES_URL_NON_POOLING="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres"

# Public Supabase project values. These are intentionally available to the browser for Auth and Storage RLS.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"

# Server-only Supabase key for restricted administrative Auth operations and development seed cleanup.
# Ordinary portal reads/uploads/downloads use the signed-in user's RLS-bound client.
SUPABASE_SECRET_KEY="sb_secret_REPLACE_ME"
SUPABASE_STORAGE_BUCKET="bridge-ai-private"

# Application security. Generate separate random values for every environment.
APP_URL="http://localhost:3000"
PII_ENCRYPTION_KEY_V1="BASE64_ENCODED_32_BYTE_KEY"
PII_BLIND_INDEX_KEY="LONG_RANDOM_SECRET"

# Development seed is opt-in and is always rejected in production.
ALLOW_DEVELOPMENT_SEED="false"
SEED_SUPPLIER_EMAIL=""
SEED_SUPPLIER_PASSWORD=""

# Email delivery for password resets.
RESEND_API_KEY="re_REPLACE_ME"
EMAIL_FROM="Bridge-iT <notifications@example.com>"
# Comma-separated administrator addresses for production incident alerts.
MONITORING_ALERT_EMAILS="operations@example.com"

# Server-side integrations only — never expose these with NEXT_PUBLIC_ prefixes.
# Meta callback: APP_URL/api/webhooks/meta-whatsapp
# The verify token is an independent high-entropy value; the app secret comes from the Meta app settings.
META_WHATSAPP_ACCESS_TOKEN=""
META_WHATSAPP_PHONE_NUMBER_ID=""
# Pin and deliberately upgrade the Graph API version after compatibility testing.
META_GRAPH_API_VERSION="v26.0"
WHATSAPP_ALLOW_PAID_TEMPLATES="false"
META_WHATSAPP_QUOTE_TEMPLATE_NAME="bridge_ai_quote_update"
META_WHATSAPP_CONTACT_TEMPLATE_NAME="bridge_ai_contact_unlocked"
# Approved authentication template with one body variable containing the
# short-lived Buyer Hub sign-in URL. Required before passwordless login can send.
META_WHATSAPP_BUYER_LOGIN_TEMPLATE_NAME="bridge_it_buyer_login"
META_WHATSAPP_TEMPLATE_LANGUAGE="en_GB"
META_WHATSAPP_VERIFY_TOKEN=""
META_WHATSAPP_APP_SECRET=""
OPENAI_API_KEY=""
# Balanced customer-intake model; override only after an evaluated model change.
OPENAI_MODEL="gpt-5.6-terra"
# Supplier response time uses Europe/London and pauses Friday 15:00 to Monday 08:00.
QUOTE_RESPONSE_HOURS="48"
DEFAULT_QUOTE_DISTRIBUTION_LIMIT="5"
# Immutable points awarded once when an order first becomes completed.
BUYER_REWARD_COMPLETION_POINTS="100"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Recurring monthly Stripe Prices. Both must use GBP and a
# Legacy founding subscription price IDs only. New geographic plans create and
# persist their own Stripe Product/Price IDs from administrator plan settings.
STRIPE_INTRODUCTORY_PRICE_ID=""
STRIPE_STANDARD_PRICE_ID=""
# Vercel sends this server-only bearer token to scheduled maintenance routes.
CRON_SECRET=""
