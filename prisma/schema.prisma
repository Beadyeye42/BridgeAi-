generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
  schemas   = ["bridge_ai"]
}

enum AccountStatus {
  ACTIVE
  INVITED
  LOCKED
  SUSPENDED

  @@schema("bridge_ai")
}

enum SupplierStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED

  @@schema("bridge_ai")
}

enum SupplierTeamRole {
  OWNER
  MANAGER
  MEMBER

  @@schema("bridge_ai")
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED

  @@schema("bridge_ai")
}

enum ConversationChannel {
  WHATSAPP

  @@schema("bridge_ai")
}

enum MessageDirection {
  INBOUND
  OUTBOUND

  @@schema("bridge_ai")
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  LOCATION
  INTERACTIVE
  SYSTEM

  @@schema("bridge_ai")
}

enum MessageStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED

  @@schema("bridge_ai")
}

enum AiConversationStage {
  CONSENT_REQUIRED
  COLLECTING
  AWAITING_CONFIRMATION
  QUOTE_CREATED
  AWAITING_SELECTION
  SELECTION_RECORDED
  HUMAN_REVIEW
  CLOSED

  @@schema("bridge_ai")
}

enum WhatsAppJobType {
  PROCESS_INBOUND
  SEND_QUOTE_SUMMARY
  SEND_CONTACT_UNLOCK

  @@schema("bridge_ai")
}

enum WhatsAppJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@schema("bridge_ai")
}

enum AttachmentKind {
  CUSTOMER_FILE
  DRAWING
  PHOTO
  SUPPLIER_LOGO
  QUOTATION_PDF
  ACCREDITATION_DOCUMENT
  OTHER

  @@schema("bridge_ai")
}

enum ScanStatus {
  PENDING
  CLEAN
  REJECTED
  FAILED

  @@schema("bridge_ai")
}

enum QuoteRequestStatus {
  DRAFT
  OPEN
  MATCHING
  QUOTED
  WON
  LOST
  EXPIRED
  CANCELLED

  @@schema("bridge_ai")
}

enum AssignmentStatus {
  PENDING
  VIEWED
  ACCEPTED
  DECLINED
  QUOTED
  EXPIRED
  WITHDRAWN

  @@schema("bridge_ai")
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  SELECTED_PENDING_PAYMENT
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED

  @@schema("bridge_ai")
}

enum CoverageType {
  POSTCODE
  DISTANCE
  NATIONWIDE

  @@schema("bridge_ai")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED

  @@schema("bridge_ai")
}

enum NotificationType {
  NEW_QUOTE_REQUEST
  REQUEST_EXPIRING
  QUOTATION_ACCEPTED
  QUOTATION_REJECTED
  SUCCESS_FEE_DUE
  CONTACT_DETAILS_UNLOCKED
  TEAM_INVITATION
  ACCOUNT_UPDATE
  SYSTEM

  @@schema("bridge_ai")
}

enum SuccessFeeStatus {
  PENDING
  CHECKOUT_CREATED
  PAID
  EXPIRED
  REFUNDED
  DISPUTED

  @@schema("bridge_ai")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP

  @@schema("bridge_ai")
}

enum SystemEventSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL

  @@schema("bridge_ai")
}

enum SystemEventStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED

  @@schema("bridge_ai")
}

enum AccreditationType {
  PUBLIC_LIABILITY_INSURANCE
  EMPLOYERS_LIABILITY_INSURANCE
  PROFESSIONAL_INDEMNITY_INSURANCE
  TRADE_BODY_MEMBERSHIP
  CERTIFICATION
  OTHER

  @@schema("bridge_ai")
}

enum AccreditationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED

  @@schema("bridge_ai")
}

model User {
  id                       String                    @id @db.Uuid
  email                    String                    @unique @db.Citext
  firstName                String
  lastName                 String
  status                   AccountStatus             @default(ACTIVE)
  emailVerifiedAt          DateTime?
  lastLoginAt              DateTime?
  termsAcceptedAt          DateTime?
  termsVersion             String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  memberships              SupplierTeamMembership[]
  platformAdministrator    PlatformAdministrator?
  administratorPermissions AdministratorPermission[]
  invitationsSent          SupplierInvite[]          @relation("InviteSender")
  notifications            Notification[]
  notificationPrefs        NotificationPreference[]
  auditLogs                AuditLog[]                @relation("AuditActor")
  uploadedAttachments      Attachment[]              @relation("AttachmentUploader")
  approvedSuppliers        SupplierCompany[]         @relation("SupplierApprover")
  assignmentsCreated       SupplierAssignment[]      @relation("AssignmentCreator")
  systemEventsResolved     SystemEvent[]             @relation("SystemEventResolver")
  accreditationsCreated    SupplierAccreditation[]   @relation("AccreditationCreator")
  accreditationsReviewed   SupplierAccreditation[]   @relation("AccreditationReviewer")

  @@index([status])
  @@map("portal_profiles")
  @@schema("bridge_ai")
}

model PlatformAdministrator {
  userId    String   @id @db.Uuid
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("platform_administrators")
  @@schema("bridge_ai")
}

model Permission {
  id             String                    @id @default(cuid())
  code           String                    @unique
  description    String?
  administrators AdministratorPermission[]

  @@map("permissions")
  @@schema("bridge_ai")
}

model AdministratorPermission {
  userId       String     @db.Uuid
  permissionId String
  grantedAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId])
  @@map("administrator_permissions")
  @@schema("bridge_ai")
}

model SupplierCompany {
  id                String                    @id @default(cuid())
  legalName         String
  tradingName       String?
  companyNumber     String?
  vatNumber         String?
  websiteUrl        String?
  logoUrl           String?
  summary           String?
  contactEmail      String
  contactPhone      String
  addressLine1      String?
  addressLine2      String?
  city              String?
  county            String?
  postcode          String?
  businessHours     Json?
  status            SupplierStatus            @default(PENDING)
  approvedAt        DateTime?
  approvedById      String?                   @db.Uuid
  suspendedAt       DateTime?
  suspensionNote    String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  approvedBy        User?                     @relation("SupplierApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  memberships       SupplierTeamMembership[]
  invitations       SupplierInvite[]
  coverageAreas     CoverageArea[]
  categories        SupplierProductCategory[]
  assignments       SupplierAssignment[]
  quotations        SupplierQuotation[]
  subscription      Subscription?
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  auditLogs         AuditLog[]
  attachments       Attachment[]
  successFees       SupplierSuccessFee[]
  contactAccess     ContactAccessGrant[]
  accreditations    SupplierAccreditation[]

  @@index([status])
  @@index([postcode])
  @@index([approvedById])
  @@map("supplier_companies")
  @@schema("bridge_ai")
}

model SupplierTeamMembership {
  id                String           @id @default(cuid())
  userId            String           @db.Uuid
  supplierCompanyId String
  role              SupplierTeamRole @default(MEMBER)
  status            MembershipStatus @default(ACTIVE)
  isPrimary         Boolean          @default(false)
  joinedAt          DateTime         @default(now())
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplierCompany   SupplierCompany  @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)

  @@unique([userId, supplierCompanyId])
  @@index([supplierCompanyId, role])
  @@map("company_memberships")
  @@schema("bridge_ai")
}

model SupplierInvite {
  id                String           @id @default(cuid())
  supplierCompanyId String
  email             String
  role              SupplierTeamRole @default(MEMBER)
  tokenHash         String           @unique
  invitedById       String           @db.Uuid
  expiresAt         DateTime
  acceptedAt        DateTime?
  createdAt         DateTime         @default(now())
  supplierCompany   SupplierCompany  @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  invitedBy         User             @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@unique([supplierCompanyId, email])
  @@index([email, expiresAt])
  @@index([invitedById])
  @@schema("bridge_ai")
}

model CustomerContact {
  id                   String               @id @default(cuid())
  displayNameEncrypted Bytes?
  phoneEncrypted       Bytes
  phoneHash            String               @unique
  emailEncrypted       Bytes?
  emailHash            String?
  consentRecordedAt    DateTime?
  marketingConsentAt   DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  conversations        Conversation[]
  quoteRequests        QuoteRequest[]
  contactAccess        ContactAccessGrant[]

  @@index([emailHash])
  @@schema("bridge_ai")
}

model Conversation {
  id                     String              @id @default(cuid())
  customerContactId      String
  channel                ConversationChannel @default(WHATSAPP)
  externalConversationId String?             @unique
  lastMessageAt          DateTime?
  aiStage                AiConversationStage @default(CONSENT_REQUIRED)
  aiConsentAt            DateTime?
  aiDraftEncrypted       Bytes?
  closedAt               DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  customerContact        CustomerContact     @relation(fields: [customerContactId], references: [id], onDelete: Restrict)
  messages               WhatsAppMessage[]
  quoteRequests          QuoteRequest[]
  whatsappJobs           WhatsAppJob[]

  @@index([customerContactId, lastMessageAt])
  @@schema("bridge_ai")
}

model WhatsAppMessage {
  id                     String           @id @default(cuid())
  conversationId         String
  externalMessageId      String           @unique
  direction              MessageDirection
  messageType            MessageType
  bodyEncrypted          Bytes?
  mediaIdEncrypted       Bytes?
  mediaMimeType          String?
  mediaFileNameEncrypted Bytes?
  status                 MessageStatus
  occurredAt             DateTime
  deliveredAt            DateTime?
  readAt                 DateTime?
  failureCode            String?
  failureMessage         String?
  createdAt              DateTime         @default(now())
  conversation           Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments            Attachment[]
  whatsappJobs           WhatsAppJob[]

  @@index([conversationId, occurredAt])
  @@index([status])
  @@schema("bridge_ai")
}

model Attachment {
  id                String                 @id @default(cuid())
  kind              AttachmentKind
  fileName          String
  mimeType          String
  byteSize          Int
  storageKey        String                 @unique
  sha256            String
  scanStatus        ScanStatus             @default(PENDING)
  aiSummaryEncrypted Bytes?
  aiAnalyzedAt       DateTime?
  aiAnalysisModel    String?
  aiResponseIdHash   String?
  whatsappMessageId String?
  quoteRequestId    String?
  quotationId       String?
  supplierCompanyId String?
  uploadedById      String?                @db.Uuid
  createdAt         DateTime               @default(now())
  whatsappMessage   WhatsAppMessage?       @relation(fields: [whatsappMessageId], references: [id], onDelete: SetNull)
  quoteRequest      QuoteRequest?          @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  quotation         SupplierQuotation?     @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  supplierCompany   SupplierCompany?       @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  uploadedBy        User?                  @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  accreditation     SupplierAccreditation?

  @@index([quoteRequestId])
  @@index([quotationId])
  @@index([scanStatus])
  @@index([uploadedById])
  @@index([supplierCompanyId])
  @@index([whatsappMessageId])
  @@schema("bridge_ai")
}

model SupplierAccreditation {
  id                String              @id @default(cuid())
  supplierCompanyId String
  attachmentId      String              @unique
  type              AccreditationType
  displayName       String
  referenceNumber   String?
  issuingBody       String?
  issuedAt          DateTime?
  expiresAt         DateTime?
  status            AccreditationStatus @default(PENDING)
  reviewNote        String?
  reviewedAt        DateTime?
  reviewedById      String?             @db.Uuid
  createdById       String              @db.Uuid
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  supplierCompany   SupplierCompany     @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  attachment        Attachment          @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  reviewedBy        User?               @relation("AccreditationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdBy         User                @relation("AccreditationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([supplierCompanyId, status, expiresAt])
  @@index([reviewedById])
  @@index([createdById])
  @@map("supplier_accreditations")
  @@schema("bridge_ai")
}

model ProductCategory {
  id            String                    @id @default(cuid())
  name          String
  slug          String                    @unique
  description   String?
  active        Boolean                   @default(true)
  parentId      String?
  displayOrder  Int                       @default(0)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  parent        ProductCategory?          @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      ProductCategory[]         @relation("CategoryTree")
  suppliers     SupplierProductCategory[]
  quoteRequests QuoteRequest[]

  @@unique([parentId, name])
  @@index([active, displayOrder])
  @@schema("bridge_ai")
}

model SupplierProductCategory {
  supplierCompanyId String
  productCategoryId String
  createdAt         DateTime        @default(now())
  supplierCompany   SupplierCompany @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  productCategory   ProductCategory @relation(fields: [productCategoryId], references: [id], onDelete: Cascade)

  @@id([supplierCompanyId, productCategoryId])
  @@index([productCategoryId])
  @@schema("bridge_ai")
}

model QuoteRequest {
  id                String               @id @default(cuid())
  reference         String               @unique
  conversationId    String?
  customerContactId String
  categoryId        String
  title             String
  summary           String
  deliveryPostcode  String
  deliveryLatitude  Decimal?             @db.Decimal(9, 6)
  deliveryLongitude Decimal?             @db.Decimal(9, 6)
  customerBudget    Decimal?             @db.Decimal(12, 2)
  currency          String               @default("GBP") @db.VarChar(3)
  status            QuoteRequestStatus   @default(DRAFT)
  distributionLimit Int                  @default(3)
  responseDueAt     DateTime
  publishedAt       DateTime?
  closedAt          DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  conversation      Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  customerContact   CustomerContact      @relation(fields: [customerContactId], references: [id], onDelete: Restrict)
  category          ProductCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  items             QuoteRequestItem[]
  attachments       Attachment[]
  assignments       SupplierAssignment[]
  quotations        SupplierQuotation[]
  successFees       SupplierSuccessFee[]
  whatsappJobs      WhatsAppJob[]

  @@index([status, responseDueAt])
  @@index([categoryId, deliveryPostcode])
  @@index([customerContactId])
  @@index([conversationId])
  @@schema("bridge_ai")
}

model QuoteRequestItem {
  id             String       @id @default(cuid())
  quoteRequestId String
  description    String
  quantity       Decimal      @db.Decimal(12, 3)
  unit           String
  specification  String?
  displayOrder   Int          @default(0)
  createdAt      DateTime     @default(now())
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  @@index([quoteRequestId, displayOrder])
  @@schema("bridge_ai")
}

model SupplierAssignment {
  id                String             @id @default(cuid())
  quoteRequestId    String
  supplierCompanyId String
  status            AssignmentStatus   @default(PENDING)
  assignedAt        DateTime           @default(now())
  viewedAt          DateTime?
  respondedAt       DateTime?
  expiresAt         DateTime
  declinedReason    String?
  assignedById      String?            @db.Uuid
  quoteRequest      QuoteRequest       @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  supplierCompany   SupplierCompany    @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  assignedBy        User?              @relation("AssignmentCreator", fields: [assignedById], references: [id], onDelete: SetNull)
  quotation         SupplierQuotation?

  @@unique([quoteRequestId, supplierCompanyId])
  @@index([supplierCompanyId, status, assignedAt])
  @@index([quoteRequestId, status])
  @@index([assignedById])
  @@schema("bridge_ai")
}

model SupplierQuotation {
  id                String              @id @default(cuid())
  quoteRequestId    String
  supplierCompanyId String
  assignmentId      String              @unique
  status            QuotationStatus     @default(DRAFT)
  price             Decimal             @db.Decimal(12, 2)
  currency          String              @default("GBP") @db.VarChar(3)
  leadTimeDays      Int
  validUntil        DateTime?
  notes             String?
  submittedAt       DateTime?
  decidedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  quoteRequest      QuoteRequest        @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  supplierCompany   SupplierCompany     @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  assignment        SupplierAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  attachments       Attachment[]
  successFee        SupplierSuccessFee?
  contactAccess     ContactAccessGrant?
  whatsappJobs      WhatsAppJob[]

  @@unique([quoteRequestId, supplierCompanyId])
  @@index([supplierCompanyId, status, submittedAt])
  @@schema("bridge_ai")
}

model WhatsAppJob {
  id                     String             @id @default(cuid())
  type                   WhatsAppJobType
  status                 WhatsAppJobStatus  @default(PENDING)
  idempotencyKey         String             @unique
  conversationId         String?
  whatsappMessageId      String?
  quoteRequestId         String?
  quotationId            String?
  attempts               Int                @default(0)
  availableAt            DateTime           @default(now())
  lockedAt               DateTime?
  completedAt            DateTime?
  failedAt               DateTime?
  errorCode              String?
  model                  String?
  providerResponseIdHash String?
  inputTokens            Int?
  outputTokens           Int?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  conversation           Conversation?      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  whatsappMessage        WhatsAppMessage?   @relation(fields: [whatsappMessageId], references: [id], onDelete: Cascade)
  quoteRequest           QuoteRequest?      @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  quotation              SupplierQuotation? @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([status, availableAt, createdAt])
  @@index([conversationId, createdAt])
  @@index([whatsappMessageId])
  @@index([quoteRequestId, createdAt])
  @@index([quotationId])
  @@schema("bridge_ai")
}

model SupplierSuccessFee {
  id                        String              @id @default(cuid())
  quotationId               String              @unique
  quoteRequestId            String
  supplierCompanyId         String
  amountPence               Int                 @default(2500)
  currency                  String              @default("GBP") @db.VarChar(3)
  status                    SuccessFeeStatus    @default(PENDING)
  provider                  String              @default("stripe")
  providerCheckoutSessionId String?             @unique
  providerPaymentIntentId   String?             @unique
  checkoutAttempt           Int                 @default(0)
  selectedAt                DateTime            @default(now())
  paymentDueAt              DateTime
  paidAt                    DateTime?
  unlockedAt                DateTime?
  expiredAt                 DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  quotation                 SupplierQuotation   @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  quoteRequest              QuoteRequest        @relation(fields: [quoteRequestId], references: [id], onDelete: Restrict)
  supplierCompany           SupplierCompany     @relation(fields: [supplierCompanyId], references: [id], onDelete: Restrict)
  contactAccess             ContactAccessGrant?

  @@index([supplierCompanyId, status, paymentDueAt])
  @@index([quoteRequestId, status])
  @@schema("bridge_ai")
}

model ContactAccessGrant {
  id                      String             @id @default(cuid())
  successFeeId            String             @unique
  quotationId             String             @unique
  customerContactId       String
  supplierCompanyId       String
  reason                  String             @default("SUCCESS_FEE_PAID")
  grantedAt               DateTime           @default(now())
  revokedAt               DateTime?
  customerNotifiedAt      DateTime?
  notificationAttemptedAt DateTime?
  notificationFailureCode String?
  createdAt               DateTime           @default(now())
  successFee              SupplierSuccessFee @relation(fields: [successFeeId], references: [id], onDelete: Restrict)
  quotation               SupplierQuotation  @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  customerContact         CustomerContact    @relation(fields: [customerContactId], references: [id], onDelete: Restrict)
  supplierCompany         SupplierCompany    @relation(fields: [supplierCompanyId], references: [id], onDelete: Restrict)

  @@index([supplierCompanyId, grantedAt])
  @@index([customerContactId])
  @@schema("bridge_ai")
}

model CoverageArea {
  id                String          @id @default(cuid())
  supplierCompanyId String
  type              CoverageType
  label             String
  postcodePrefix    String?
  centrePostcode    String?
  radiusMiles       Int?
  latitude          Decimal?        @db.Decimal(9, 6)
  longitude         Decimal?        @db.Decimal(9, 6)
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  supplierCompany   SupplierCompany @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)

  @@index([supplierCompanyId, active])
  @@index([postcodePrefix])
  @@schema("bridge_ai")
}

model Subscription {
  id                     String             @id @default(cuid())
  supplierCompanyId      String             @unique
  provider               String             @default("stripe")
  providerCustomerId     String?            @unique
  providerSubscriptionId String?            @unique
  planCode               String
  status                 SubscriptionStatus
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  trialEndsAt            DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  supplierCompany        SupplierCompany    @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)

  @@index([status, currentPeriodEnd])
  @@schema("bridge_ai")
}

model NotificationPreference {
  id                    String          @id @default(cuid())
  userId                String          @db.Uuid
  supplierCompanyId     String
  emailNewRequests      Boolean         @default(true)
  emailRequestReminders Boolean         @default(true)
  emailQuotationUpdates Boolean         @default(true)
  smsUrgentRequests     Boolean         @default(false)
  inAppEnabled          Boolean         @default(true)
  quietHoursStart       String?
  quietHoursEnd         String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplierCompany       SupplierCompany @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)

  @@unique([userId, supplierCompanyId])
  @@index([supplierCompanyId])
  @@schema("bridge_ai")
}

model Notification {
  id                String              @id @default(cuid())
  userId            String              @db.Uuid
  supplierCompanyId String?
  type              NotificationType
  channel           NotificationChannel @default(IN_APP)
  title             String
  body              String
  actionUrl         String?
  readAt            DateTime?
  sentAt            DateTime?
  failedAt          DateTime?
  failureReason     String?
  createdAt         DateTime            @default(now())
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplierCompany   SupplierCompany?    @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([supplierCompanyId, type])
  @@schema("bridge_ai")
}

model AuditLog {
  id                String           @id @default(cuid())
  actorUserId       String?          @db.Uuid
  supplierCompanyId String?
  action            String
  entityType        String
  entityId          String?
  summary           String
  metadata          Json?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime         @default(now())
  actor             User?            @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  supplierCompany   SupplierCompany? @relation(fields: [supplierCompanyId], references: [id], onDelete: SetNull)

  @@index([supplierCompanyId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@schema("bridge_ai")
}

model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  externalEventId String
  eventType       String
  payload         Json
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  retryCount      Int       @default(0)

  @@unique([provider, externalEventId])
  @@index([provider, processedAt, failedAt])
  @@schema("bridge_ai")
}

model SystemEvent {
  id           String              @id @default(cuid())
  severity     SystemEventSeverity
  status       SystemEventStatus   @default(OPEN)
  source       String
  code         String
  message      String
  context      Json?
  occurredAt   DateTime            @default(now())
  resolvedAt   DateTime?
  resolvedById String?             @db.Uuid
  resolvedBy   User?               @relation("SystemEventResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, severity, occurredAt])
  @@index([source, code])
  @@index([resolvedById])
  @@schema("bridge_ai")
}
