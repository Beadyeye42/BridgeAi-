{
  "name": "bridge-ai-supplier-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "prisma generate",
    "db:migrate": "supabase migration new",
    "db:deploy": "supabase db push",
    "db:status": "supabase migration list",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.111.0",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "sharp": "0.35.3",
    "stripe": "22.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.12",
    "prisma": "^6.19.3",
    "supabase": "2.111.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.4",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "type": "module"
}
