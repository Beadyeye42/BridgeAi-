  affiliate                          Affiliate               @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  supplierCompany                    SupplierCompany         @relation(fields: [supplierCompanyId], references: [id], onDelete: Restrict)
  commissions                        AffiliateCommission[]

  @@index([affiliateId, status, createdAt])
  @@index([referralCode])
  @@map("affiliate_referrals")
  @@schema("bridge_ai")
}

model ReferralClick {
  id                   String    @id @default(cuid())
  affiliateId          String
  referralCode         String    @db.VarChar(24)
  attributionTokenHash String?   @db.VarChar(64)
  ipHash               String?   @db.VarChar(64)
  userAgent            String?
  landingPath          String?
  convertedAt          DateTime?
  supplierCompanyId    String?
  createdAt            DateTime  @default(now())
  affiliate            Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId, createdAt])
  @@index([supplierCompanyId])
  @@map("referral_clicks")
  @@schema("bridge_ai")
}

model AffiliateCommission {
  id                    String                       @id @default(cuid())
  externalLedgerKey     String                       @unique
  entryType             AffiliateCommissionEntryType @default(INVOICE)
  affiliateId           String
  referralId            String
  supplierCompanyId     String
  subscriptionId        String
  membershipPlanId      String?
  stripeInvoiceId       String
  stripePaymentId       String?
  stripeChargeId        String?
  stripeRefundId        String?
  stripeDisputeId       String?
  sourceCommissionId    String?
  planCode              String
  currency              String                       @default("GBP") @db.VarChar(3)
  billingAmountPence    Int
  vatAmountPence        Int
  eligibleRevenuePence  Int
  commissionRateBps     Int
  commissionAmountPence Int
  paidBillingPeriod     Int?
  commissionSequence    Int?
  billingPeriodStart    DateTime?
  billingPeriodEnd      DateTime?
  status                AffiliateCommissionStatus
  earnedAt              DateTime
  validationAt          DateTime?
  validatedAt           DateTime?
  paidAt                DateTime?
  reversedAt            DateTime?
  createdAt             DateTime                     @default(now())
  affiliate             Affiliate                    @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  referral              AffiliateReferral            @relation(fields: [referralId], references: [id], onDelete: Restrict)
  supplierCompany       SupplierCompany              @relation(fields: [supplierCompanyId], references: [id], onDelete: Restrict)
  subscription          Subscription                 @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  membershipPlan        MembershipPlan?              @relation(fields: [membershipPlanId], references: [id], onDelete: Restrict)
  sourceCommission      AffiliateCommission?         @relation("AffiliateCommissionAdjustments", fields: [sourceCommissionId], references: [id], onDelete: Restrict)
  adjustments           AffiliateCommission[]        @relation("AffiliateCommissionAdjustments")
  payoutItem            AffiliatePayoutItem?

  @@index([affiliateId, earnedAt])
  @@index([affiliateId, status, validationAt])
  @@index([referralId, earnedAt])
  @@index([stripeInvoiceId])
  @@index([stripeChargeId])
  @@index([supplierCompanyId])
  @@index([subscriptionId], map: "affiliate_commissions_subscription_idx")
  @@index([membershipPlanId], map: "affiliate_commissions_membership_plan_idx")
  @@index([sourceCommissionId], map: "affiliate_commissions_source_idx")
  @@map("affiliate_commissions")
  @@schema("bridge_ai")
}

model AffiliatePayout {
  id                         String                @id @default(cuid())
  affiliateId                String
  statementReference         String                @unique
  periodStart                DateTime
  periodEnd                  DateTime
  currency                   String                @default("GBP") @db.VarChar(3)
  openingPendingBalancePence Int
  commissionsEarnedPence     Int
  reversalsPence             Int
  adjustmentsPence           Int
  amountPaidPence            Int
  closingBalancePence        Int
  status                     AffiliatePayoutStatus @default(PENDING)
  scheduledAt                DateTime?
  paidAt                     DateTime?
  paymentReference           String?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  affiliate                  Affiliate             @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  items                      AffiliatePayoutItem[]

  @@index([affiliateId, periodStart, periodEnd])
  @@index([status, createdAt])
  @@map("affiliate_payouts")
  @@schema("bridge_ai")
}

model AffiliatePayoutItem {
  id           String              @id @default(cuid())
  payoutId     String
  commissionId String              @unique
  amountPence  Int
  createdAt    DateTime            @default(now())
  payout       AffiliatePayout     @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  commission   AffiliateCommission @relation(fields: [commissionId], references: [id], onDelete: Restrict)

  @@index([payoutId])
  @@map("affiliate_payout_items")
  @@schema("bridge_ai")
}

model AffiliateNotification {
  id          String                    @id @default(cuid())
  affiliateId String
  type        AffiliateNotificationType
  title       String
  body        String
  actionUrl   String?
  readAt      DateTime?
  emailedAt   DateTime?
  createdAt   DateTime                  @default(now())
  affiliate   Affiliate                 @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId, readAt, createdAt])
  @@map("affiliate_notifications")
  @@schema("bridge_ai")
}

model AffiliateAuditLog {
  id          String     @id @default(cuid())
  affiliateId String?
  actorUserId String?    @db.Uuid
  action      String
  entityType  String
  entityId    String?
  summary     String
  metadata    Json?
  createdAt   DateTime   @default(now())
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  actor       User?      @relation("AffiliateAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([affiliateId, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("affiliate_audit_logs")
  @@schema("bridge_ai")
}

model SystemEvent {
  id           String              @id @default(cuid())
  severity     SystemEventSeverity
  status       SystemEventStatus   @default(OPEN)
  source       String
  code         String
  message      String
  context      Json?
  occurredAt   DateTime            @default(now())
  resolvedAt   DateTime?
  resolvedById String?             @db.Uuid
  resolvedBy   User?               @relation("SystemEventResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, severity, occurredAt])
  @@index([source, code])
  @@index([resolvedById])
  @@schema("bridge_ai")
}

model ProductionAlert {
  id              String                @id @default(cuid())
  fingerprint     String                @unique
  source          String
  severity        SystemEventSeverity
  title           String
  body            String
  actionUrl       String?
  status          ProductionAlertStatus @default(PENDING)
  attempts        Int                   @default(0)
  availableAt     DateTime              @default(now())
  lockedAt        DateTime?
  sentAt          DateTime?
  failedAt        DateTime?
  lastError       String?
  providerEmailId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([status, availableAt, createdAt])
  @@index([source, createdAt])
  @@schema("bridge_ai")
}
