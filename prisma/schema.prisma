generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
  schemas   = ["bridge_ai"]
}

enum AccountStatus {
  ACTIVE
  INVITED
  LOCKED
  SUSPENDED

  @@schema("bridge_ai")
}

enum SupplierStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED

  @@schema("bridge_ai")
}

enum SupplierTeamRole {
  OWNER
  MANAGER
  MEMBER

  @@schema("bridge_ai")
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED

  @@schema("bridge_ai")
}

enum ConversationChannel {
  WHATSAPP

  @@schema("bridge_ai")
}

enum MessageDirection {
  INBOUND
  OUTBOUND

  @@schema("bridge_ai")
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  LOCATION
  INTERACTIVE
  SYSTEM

  @@schema("bridge_ai")
}

enum MessageStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED

  @@schema("bridge_ai")
}

enum AiConversationStage {
  CONSENT_REQUIRED
  COLLECTING
  AWAITING_CONFIRMATION
  QUOTE_CREATED
  AWAITING_SELECTION
  SELECTION_RECORDED
  HUMAN_REVIEW
  CLOSED

  @@schema("bridge_ai")
}

enum WhatsAppJobType {
  PROCESS_INBOUND
  SEND_INTAKE_FALLBACK
  SEND_QUOTE_SUMMARY
  SEND_CONTACT_UNLOCK
  SEND_QUOTE_MESSAGE

  @@schema("bridge_ai")
}

enum WhatsAppJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@schema("bridge_ai")
}

enum AttachmentKind {
  CUSTOMER_FILE
  DRAWING
  PHOTO
  SUPPLIER_LOGO
  QUOTATION_PDF
  ACCREDITATION_DOCUMENT
  OTHER

  @@schema("bridge_ai")
}

enum ScanStatus {
  PENDING
  CLEAN
  REJECTED
  FAILED

  @@schema("bridge_ai")
}

enum QuoteRequestStatus {
  DRAFT
  OPEN
  MATCHING
  QUOTED
  SELECTED
  CONFIRMED
  COMPLETED
  CANCELLED_AFTER_SELECTION
  WON
  LOST
  EXPIRED
  CANCELLED

  @@schema("bridge_ai")
}

enum AssignmentStatus {
  PENDING
  VIEWED
  ACCEPTED
  DECLINED
  QUOTED
  EXPIRED
  WITHDRAWN

  @@schema("bridge_ai")
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  SELECTED_PENDING_PAYMENT
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED

  @@schema("bridge_ai")
}

enum QuoteConversationStatus {
  OPEN
  SELECTED
  CLOSED
  EXPIRED

  @@schema("bridge_ai")
}

enum QuoteMessageSender {
  BUYER
  SUPPLIER
  SYSTEM

  @@schema("bridge_ai")
}

enum QuoteMessageStatus {
  PENDING
  DELIVERED
  BLOCKED
  FAILED

  @@schema("bridge_ai")
}

enum CoverageType {
  POSTCODE
  DISTANCE
  NATIONWIDE

  @@schema("bridge_ai")
}

enum CoveragePurpose {
  SERVICE
  DELIVERY

  @@schema("bridge_ai")
}

enum MembershipTier {
  HYPERLOCAL
  LOCAL
  REGIONAL
  NATIONWIDE

  @@schema("bridge_ai")
}

enum FulfilmentMode {
  SERVICE
  INSTALLATION
  SUPPLY_ONLY
  DELIVERY
  COLLECTION

  @@schema("bridge_ai")
}

enum SupplierCapacityStatus {
  AVAILABLE
  LIMITED
  URGENT_ONLY
  FULL
  PAUSED
  HOLIDAY
  NOT_ACCEPTING

  @@schema("bridge_ai")
}

enum LiveAvailabilityStatus {
  AVAILABLE_NOW
  AVAILABLE_TODAY
  AVAILABLE_TOMORROW
  LIMITED
  FULLY_BOOKED
  PAUSED
  HOLIDAY

  @@schema("bridge_ai")
}

enum RequestUrgency {
  EMERGENCY
  WITHIN_2_HOURS
  SAME_DAY
  NEXT_DAY
  THIS_WEEK
  FLEXIBLE
  FUTURE_BOOKING

  @@schema("bridge_ai")
}

enum RecurrenceCadence {
  ONE_OFF
  WEEKLY
  FORTNIGHTLY
  MONTHLY

  @@schema("bridge_ai")
}

enum SupplierMatchOutcome {
  MATCHED
  REJECTED

  @@schema("bridge_ai")
}

enum MarketDensityMode {
  EMPTY
  SPARSE
  HEALTHY
  DENSE

  @@schema("bridge_ai")
}

enum BuyerType {
  CONSUMER
  TRADE
  BUSINESS

  @@schema("bridge_ai")
}

enum IntentQuality {
  BROWSING
  QUALIFIED
  URGENT
  READY_TO_BUY

  @@schema("bridge_ai")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED

  @@schema("bridge_ai")
}

enum SubscriptionAccessSource {
  STRIPE
  COMPLIMENTARY

  @@schema("bridge_ai")
}

enum NotificationType {
  NEW_QUOTE_REQUEST
  BUYER_QUESTION
  QUOTE_REVISED
  REQUEST_EXPIRING
  QUOTATION_ACCEPTED
  QUOTATION_REJECTED
  SUCCESS_FEE_DUE
  CONTACT_DETAILS_UNLOCKED
  TEAM_INVITATION
  ACCOUNT_UPDATE
  SYSTEM

  @@schema("bridge_ai")
}

enum SuccessFeeStatus {
  PENDING
  CHECKOUT_CREATED
  PAID
  EXPIRED
  REFUNDED
  DISPUTED

  @@schema("bridge_ai")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP

  @@schema("bridge_ai")
}

enum SystemEventSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL

  @@schema("bridge_ai")
}

enum SystemEventStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED

  @@schema("bridge_ai")
}

enum ProductionAlertStatus {
  PENDING
  PROCESSING
  SENT
  FAILED

  @@schema("bridge_ai")
}

enum AccreditationType {
  PUBLIC_LIABILITY_INSURANCE
  EMPLOYERS_LIABILITY_INSURANCE
  PROFESSIONAL_INDEMNITY_INSURANCE
  TRADE_BODY_MEMBERSHIP
  CERTIFICATION
  OTHER

  @@schema("bridge_ai")
}

enum AccreditationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED

  @@schema("bridge_ai")
}

enum AffiliateStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED

  @@schema("bridge_ai")
}

enum AffiliateReferralStatus {
  CLICKED
  REGISTERED
  AWAITING_APPROVAL
  APPROVED
  QUALIFICATION_MONTH
  COMMISSION_ACTIVE
  PAST_DUE
  CANCELLATION_SCHEDULED
  CANCELLED
  COMMISSION_COMPLETED
  REJECTED

  @@schema("bridge_ai")
}

enum AffiliateCommissionEntryType {
  INVOICE
  REFUND_ADJUSTMENT
  DISPUTE_ADJUSTMENT

  @@schema("bridge_ai")
}

enum AffiliateCommissionStatus {
  QUALIFICATION
  PENDING
  AVAILABLE
  SCHEDULED
  PAID
  REVERSED
  NOT_ELIGIBLE
  ADJUSTMENT_PENDING
  ADJUSTMENT_APPLIED

  @@schema("bridge_ai")
}

enum AffiliatePayoutStatus {
  PENDING
  VALIDATING
  AVAILABLE
  SCHEDULED
  PAID
  REVERSED

  @@schema("bridge_ai")
}

enum AffiliateNotificationType {
  CANCELLATION_SCHEDULED
  CANCELLATION_COMPLETED
  PAYMENT_FAILED
  SUBSCRIPTION_RECOVERED
  PLAN_UPGRADED
  PLAN_DOWNGRADED
  COMMISSION_STARTED
  COMMISSION_COMPLETED
  COMMISSION_REVERSED
  PAYOUT_AVAILABLE
  PAYOUT_PAID
  SYSTEM

  @@schema("bridge_ai")
}

model User {
  id                       String                        @id @db.Uuid
  email                    String                        @unique @db.Citext
  firstName                String
  lastName                 String
  status                   AccountStatus                 @default(ACTIVE)
  emailVerifiedAt          DateTime?
  lastLoginAt              DateTime?
  termsAcceptedAt          DateTime?
  termsVersion             String?
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  memberships              SupplierTeamMembership[]
  platformAdministrator    PlatformAdministrator?
  administratorPermissions AdministratorPermission[]
  invitationsSent          SupplierInvite[]              @relation("InviteSender")
  notifications            Notification[]
  notificationPrefs        NotificationPreference[]
  auditLogs                AuditLog[]                    @relation("AuditActor")
  uploadedAttachments      Attachment[]                  @relation("AttachmentUploader")
  approvedSuppliers        SupplierCompany[]             @relation("SupplierApprover")
  assignmentsCreated       SupplierAssignment[]          @relation("AssignmentCreator")
  quotationVersions        QuotationVersion[]
  quoteMessages            QuoteMessage[]
  quoteModerationEvents    QuoteMessageModerationEvent[]
  systemEventsResolved     SystemEvent[]                 @relation("SystemEventResolver")
  accreditationsCreated    SupplierAccreditation[]       @relation("AccreditationCreator")
  accreditationsReviewed   SupplierAccreditation[]       @relation("AccreditationReviewer")
  complimentaryGranted     Subscription[]                @relation("ComplimentaryMembershipGrantor")
  complimentaryRevoked     Subscription[]                @relation("ComplimentaryMembershipRevoker")
  affiliate                Affiliate?
  affiliateAuditLogs       AffiliateAuditLog[]           @relation("AffiliateAuditActor")

  @@index([status])
  @@map("portal_profiles")
  @@schema("bridge_ai")
}

model PlatformAdministrator {
  userId    String   @id @db.Uuid
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("platform_administrators")
  @@schema("bridge_ai")
}

model Permission {
  id             String                    @id @default(cuid())
  code           String                    @unique
  description    String?
  administrators AdministratorPermission[]

  @@map("permissions")
  @@schema("bridge_ai")
}

model AdministratorPermission {
  userId       String     @db.Uuid
  permissionId String
  grantedAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId])
  @@map("administrator_permissions")
  @@schema("bridge_ai")
}

model SupplierCompany {
  id                                 String                    @id @default(cuid())
  legalName                          String
  tradingName                        String?
  companyNumber                      String?
  directorName                       String?
  vatNumber                          String?
  websiteUrl                         String?
  logoUrl                            String?
  summary                            String?
  contactEmail                       String
  contactPhone                       String
  addressLine1                       String?
  addressLine2                       String?
  city                               String?
  county                             String?
  postcode                           String?
  geographicOriginPostcode           String?
  geographicOriginLatitude           Decimal?                  @db.Decimal(9, 6)
  geographicOriginLongitude          Decimal?                  @db.Decimal(9, 6)
  membershipTierOverride             MembershipTier?
  maximumActiveOpportunitiesOverride Int?
  maximumServiceRadiusOverride       Int?
  maximumDeliveryRadiusOverride      Int?
  businessHours                      Json?
  status                             SupplierStatus            @default(PENDING)
  foundingMemberNumber               Int?                      @unique
  approvedAt                         DateTime?
  approvedById                       String?                   @db.Uuid
  suspendedAt                        DateTime?
  suspensionNote                     String?
  createdAt                          DateTime                  @default(now())
  updatedAt                          DateTime                  @updatedAt
  approvedBy                         User?                     @relation("SupplierApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  memberships                        SupplierTeamMembership[]
  invitations                        SupplierInvite[]
  coverageAreas                      CoverageArea[]
  collectionLocations                CollectionLocation[]
  categories                         SupplierProductCategory[]
  capabilities                       SupplierCapability[]
  matchDecisions                     SupplierMatchDecision[]
  assignments                        SupplierAssignment[]
  quotations                         SupplierQuotation[]
  subscription                       Subscription?
  notifications                      Notification[]
  notificationPrefs                  NotificationPreference[]
  auditLogs                          AuditLog[]
  attachments                        Attachment[]
  successFees                        SupplierSuccessFee[]
  contactAccess                      ContactAccessGrant[]
  accreditations                     SupplierAccreditation[]
  affiliateReferral                  AffiliateReferral?
  affiliateCommissions               AffiliateCommission[]
  quoteConversations                 QuoteConversation[]

  @@index([status])
  @@index([postcode])
  @@index([approvedById])
  @@map("supplier_companies")
  @@schema("bridge_ai")
}

model SupplierTeamMembership {
  id                String           @id @default(cuid())
  userId            String           @db.Uuid
  supplierCompanyId String
  role              SupplierTeamRole @default(MEMBER)
  status            MembershipStatus @default(ACTIVE)
  isPrimary         Boolean          @default(false)
  joinedAt          DateTime         @default(now())
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplierCompany   SupplierCompany  @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)

  @@unique([userId, supplierCompanyId])
  @@index([supplierCompanyId, role])
  @@map("company_memberships")
  @@schema("bridge_ai")
}

model SupplierInvite {
  id                String           @id @default(cuid())
  supplierCompanyId String
  email             String
  role              SupplierTeamRole @default(MEMBER)
  tokenHash         String           @unique
  invitedById       String           @db.Uuid
  expiresAt         DateTime
  acceptedAt        DateTime?
  createdAt         DateTime         @default(now())
  supplierCompany   SupplierCompany  @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  invitedBy         User             @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@unique([supplierCompanyId, email])
  @@index([email, expiresAt])
  @@index([invitedById])
  @@schema("bridge_ai")
}

model CustomerContact {
  id                          String               @id @default(cuid())
  displayNameEncrypted        Bytes?
  preferredFirstNameEncrypted Bytes?
  preferredNameAskedAt        DateTime?
  phoneEncrypted              Bytes
  phoneHash                   String               @unique
  emailEncrypted              Bytes?
  emailHash                   String?
  consentRecordedAt           DateTime?
  marketingConsentAt          DateTime?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  conversations               Conversation[]
  quoteRequests               QuoteRequest[]
  contactAccess               ContactAccessGrant[]

  @@index([emailHash])
  @@schema("bridge_ai")
}

model Conversation {
  id                     String              @id @default(cuid())
  customerContactId      String
  channel                ConversationChannel @default(WHATSAPP)
  externalConversationId String?             @unique
  lastMessageAt          DateTime?
  aiStage                AiConversationStage @default(CONSENT_REQUIRED)
  aiConsentAt            DateTime?
  aiSessionStartedAt     DateTime            @default(now())
  aiDraftEncrypted       Bytes?
  aiDraftFingerprint     String?             @db.VarChar(64)
  aiLastQuestionKey      String?             @db.VarChar(32)
  aiUnproductiveTurns    Int                 @default(0)
  aiLastProgressAt       DateTime?
  closedAt               DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  customerContact        CustomerContact     @relation(fields: [customerContactId], references: [id], onDelete: Restrict)
  messages               WhatsAppMessage[]
  quoteRequests          QuoteRequest[]
  whatsappJobs           WhatsAppJob[]

  @@index([customerContactId, lastMessageAt])
  @@schema("bridge_ai")
}

model WhatsAppMessage {
  id                     String           @id @default(cuid())
  conversationId         String
  externalMessageId      String           @unique
  direction              MessageDirection
  messageType            MessageType
  bodyEncrypted          Bytes?
  mediaIdEncrypted       Bytes?
  mediaMimeType          String?
  mediaFileNameEncrypted Bytes?
  status                 MessageStatus
  occurredAt             DateTime
  deliveredAt            DateTime?
  readAt                 DateTime?
  failureCode            String?
  failureMessage         String?
  createdAt              DateTime         @default(now())
  conversation           Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments            Attachment[]
  whatsappJobs           WhatsAppJob[]

  @@index([conversationId, occurredAt])
  @@index([status])
  @@schema("bridge_ai")
}

model Attachment {
  id                 String                 @id @default(cuid())
  kind               AttachmentKind
  fileName           String
  mimeType           String
  byteSize           Int
  storageKey         String                 @unique
  sha256             String
  scanStatus         ScanStatus             @default(PENDING)
  aiSummaryEncrypted Bytes?
  aiAnalyzedAt       DateTime?
  aiAnalysisModel    String?
  aiResponseIdHash   String?
  whatsappMessageId  String?
  quoteRequestId     String?
  quotationId        String?
  supplierCompanyId  String?
  uploadedById       String?                @db.Uuid
  createdAt          DateTime               @default(now())
  whatsappMessage    WhatsAppMessage?       @relation(fields: [whatsappMessageId], references: [id], onDelete: SetNull)
  quoteRequest       QuoteRequest?          @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  quotation          SupplierQuotation?     @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  supplierCompany    SupplierCompany?       @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  uploadedBy         User?                  @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  accreditation      SupplierAccreditation?

  @@index([quoteRequestId])
  @@index([quotationId])
  @@index([scanStatus])
  @@index([uploadedById])
  @@index([supplierCompanyId])
  @@index([whatsappMessageId])
  @@schema("bridge_ai")
}

model SupplierAccreditation {
  id                String              @id @default(cuid())
  supplierCompanyId String
  attachmentId      String              @unique
  type              AccreditationType
  displayName       String
  referenceNumber   String?
  issuingBody       String?
  issuedAt          DateTime?
  expiresAt         DateTime?
  status            AccreditationStatus @default(PENDING)
  reviewNote        String?
  reviewedAt        DateTime?
  reviewedById      String?             @db.Uuid
  createdById       String              @db.Uuid
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  supplierCompany   SupplierCompany     @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  attachment        Attachment          @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  reviewedBy        User?               @relation("AccreditationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdBy         User                @relation("AccreditationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([supplierCompanyId, status, expiresAt])
  @@index([reviewedById])
  @@index([createdById])
  @@map("supplier_accreditations")
  @@schema("bridge_ai")
}

model ProductCategory {
  id                           String                    @id @default(cuid())
  name                         String
  slug                         String                    @unique
  description                  String?
  active                       Boolean                   @default(true)
  adminVisible                 Boolean                   @default(true)
  hyperlocalEnabled            Boolean                   @default(false)
  servesConsumer               Boolean                   @default(false)
  servesTrade                  Boolean                   @default(true)
  servesBusiness               Boolean                   @default(true)
  acknowledgementDeadlineHours Int?
  quotationDeadlineHours       Int?
  parentId                     String?
  displayOrder                 Int                       @default(0)
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt
  parent                       ProductCategory?          @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children                     ProductCategory[]         @relation("CategoryTree")
  suppliers                    SupplierProductCategory[]
  quoteRequests                QuoteRequest[]
  opportunities                SupplierOpportunity[]
  capabilities                 SupplierCapability[]
  coverageGaps                 CoverageGapSignal[]

  @@unique([parentId, name])
  @@index([active, displayOrder])
  @@index([adminVisible, parentId, displayOrder])
  @@schema("bridge_ai")
}

model SupplierProductCategory {
  supplierCompanyId String
  productCategoryId String
  createdAt         DateTime        @default(now())
  supplierCompany   SupplierCompany @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  productCategory   ProductCategory @relation(fields: [productCategoryId], references: [id], onDelete: Cascade)

  @@id([supplierCompanyId, productCategoryId])
  @@index([productCategoryId])
  @@schema("bridge_ai")
}

model SupplierCapability {
  id                          String                 @id @default(cuid())
  supplierCompanyId           String
  productCategoryId           String
  manufacturerNames           String[]               @default([])
  systemNames                 String[]               @default([])
  colourNames                 String[]               @default([])
  finishNames                 String[]               @default([])
  minimumOrderValue           Decimal?               @db.Decimal(12, 2)
  minimumOrderQuantity        Int?
  standardLeadTimeDays        Int
  urgentLeadTimeDays          Int?
  currentLeadTimeDays         Int?
  supportsSupplyOnly          Boolean                @default(true)
  supportsDelivery            Boolean                @default(true)
  supportsInstallation        Boolean                @default(false)
  supportsService             Boolean                @default(false)
  servesConsumer              Boolean                @default(false)
  servesTrade                 Boolean                @default(true)
  servesBusiness              Boolean                @default(true)
  collectionAvailable         Boolean                @default(false)
  deliveryDays                Int[]                  @default([])
  capacityStatus              SupplierCapacityStatus @default(AVAILABLE)
  liveAvailability            LiveAvailabilityStatus @default(AVAILABLE_TODAY)
  nextAvailableAt             DateTime?
  availabilityLastConfirmedAt DateTime               @default(now())
  capacityLastConfirmedAt     DateTime               @default(now())
  leadTimeLastConfirmedAt     DateTime               @default(now())
  restrictedProducts          String[]               @default([])
  deliveryDelayDays           Int?
  declaredMonthlyCapacity     Int?
  shortageNote                String?
  shortageUntil               DateTime?
  active                      Boolean                @default(true)
  lastConfirmedAt             DateTime               @default(now())
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  supplierCompany             SupplierCompany        @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  productCategory             ProductCategory        @relation(fields: [productCategoryId], references: [id], onDelete: Cascade)

  @@unique([supplierCompanyId, productCategoryId])
  @@index([productCategoryId, active, capacityStatus])
  @@index([productCategoryId, active, liveAvailability, availabilityLastConfirmedAt])
  @@index([supplierCompanyId, lastConfirmedAt])
  @@schema("bridge_ai")
}

model QuoteRequest {
  id                             String                  @id @default(cuid())
  reference                      String                  @unique
  conversationId                 String?
  customerConfirmationMessageId  String?                 @unique
  customerContactId              String
  buyerType                      BuyerType
  intentQuality                  IntentQuality
  categoryId                     String
  title                          String
  summary                        String
  deliveryPostcode               String
  deliveryLatitude               Decimal?                @db.Decimal(9, 6)
  deliveryLongitude              Decimal?                @db.Decimal(9, 6)
  matchingPostcode               String?
  matchingLatitude               Decimal?                @db.Decimal(9, 6)
  matchingLongitude              Decimal?                @db.Decimal(9, 6)
  matchingCoveragePurpose        CoveragePurpose?
  customerBudget                 Decimal?                @db.Decimal(12, 2)
  requiredManufacturer           String?
  requiredSystem                 String?
  requiredColour                 String?
  requiredFinish                 String?
  requiredBy                     DateTime?
  urgency                        RequestUrgency          @default(FLEXIBLE)
  preferredTime                  String?                 @db.VarChar(80)
  recurrenceCadence              RecurrenceCadence       @default(ONE_OFF)
  qualificationData              Json?
  attachmentExtractionConfidence Decimal?                @db.Decimal(5, 4)
  previousQuoteRequestId         String?
  previousSupplierCompanyId      String?
  collectionRequired             Boolean                 @default(false)
  fulfilmentMode                 FulfilmentMode          @default(DELIVERY)
  currency                       String                  @default("GBP") @db.VarChar(3)
  status                         QuoteRequestStatus      @default(DRAFT)
  distributionLimit              Int                     @default(5)
  marketDensityMode              MarketDensityMode?
  consideredSupplierCount        Int                     @default(0)
  eliminatedSupplierCount        Int                     @default(0)
  eligibleSupplierCount          Int                     @default(0)
  invitedSupplierCount           Int                     @default(0)
  fairnessInfluence              String?
  matchingEvaluatedAt            DateTime?
  responseDueAt                  DateTime
  publishedAt                    DateTime?
  selectedAt                     DateTime?
  confirmedAt                    DateTime?
  completedAt                    DateTime?
  cancelledAfterSelectionAt      DateTime?
  closedAt                       DateTime?
  createdAt                      DateTime                @default(now())
  updatedAt                      DateTime                @updatedAt
  conversation                   Conversation?           @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  customerContact                CustomerContact         @relation(fields: [customerContactId], references: [id], onDelete: Restrict)
  category                       ProductCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  items                          QuoteRequestItem[]
  attachments                    Attachment[]
  assignments                    SupplierAssignment[]
  quotations                     SupplierQuotation[]
  successFees                    SupplierSuccessFee[]
  whatsappJobs                   WhatsAppJob[]
  opportunity                    SupplierOpportunity?
  previousQuoteRequest           QuoteRequest?           @relation("RepeatQuoteRequest", fields: [previousQuoteRequestId], references: [id], onDelete: SetNull)
  repeatQuoteRequests            QuoteRequest[]          @relation("RepeatQuoteRequest")
  matchDecisions                 SupplierMatchDecision[]
